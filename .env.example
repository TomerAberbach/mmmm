# Copy to `.env`. Generate the secret with `openssl rand -base64 32`
# One of development, test, staging, or production
APP_ENV=development
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
DATABASE_URL=postgresql://mmmm:mmmm@localhost:5432/mmmm
SUPPORT_EMAIL=support@example.com
# Comma-separated addresses whose confirmed educators are admins
ADMIN_LIST=admin@example.com
# `mailbox` keeps sent email at /dev/mailbox, and `resend` also needs RESEND_API_KEY
EMAIL_TRANSPORT=mailbox
EMAIL_FROM=MMMM <noreply@example.com>
