generator client {
  provider            = "prisma-client"
  output              = "../app/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// Better Auth's user, session, account, and verification tables. Its user is
// an Educator, and its account is a Credential, one per sign-in method. Better
// Auth rejects a schema that lacks any of its columns, including Educator.image,
// which only social sign-in sets
model Educator {
  id                String             @id
  name              String
  email             String             @unique
  emailVerified     Boolean            @default(false)
  image             String?
  // Set while an authenticator app is on, so sign-in asks for its code
  twoFactorEnabled  Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  sessions          Session[]
  credentials       Credential[]
  passkeys          Passkey[]
  authenticatorApps AuthenticatorApp[]
  contests          Contest[]
}

// How a session's educator proved who they are. A setup link lets a session
// add an admin's first second factor
enum SessionAssurance {
  PASSWORD
  SETUP_LINK
  SECOND_FACTOR
}

model Session {
  id         String           @id
  expiresAt  DateTime
  token      String           @unique
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  ipAddress  String?
  userAgent  String?
  assurance  SessionAssurance @default(PASSWORD)
  educatorId String
  educator   Educator         @relation(fields: [educatorId], references: [id], onDelete: Cascade)

  @@index([educatorId])
}

model Credential {
  id                    String    @id
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  educatorId            String
  educator              Educator  @relation(fields: [educatorId], references: [id], onDelete: Cascade)

  @@index([educatorId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// Better Auth's passkey plugin table
model Passkey {
  id           String   @id
  name         String?
  publicKey    String
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  aaguid       String?
  createdAt    DateTime @default(now())
  educatorId   String
  educator     Educator @relation(fields: [educatorId], references: [id], onDelete: Cascade)

  @@index([educatorId])
  @@index([credentialID])
}

// Better Auth's two-factor plugin table. `verified` stays false until the
// educator enters a first code from the app
model AuthenticatorApp {
  id                      String    @id
  secret                  String
  backupCodes             String
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  educatorId              String
  educator                Educator  @relation(fields: [educatorId], references: [id], onDelete: Cascade)

  @@index([educatorId])
  @@index([secret])
}

// Unpublished while `publishedAt` is null, when only the admin sees it
model Bracket {
  year             Int         @id
  publishedAt      DateTime?
  // A heads-up for educators and players. Only the first result locks
  // submissions
  expectedLockDate DateTime?   @db.Date
  // Set by the first result, when players can no longer submit. Clearing every
  // result leaves it, until the admin reopens submissions
  lockedAt         DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  divisions        Division[]
  combatants       Combatant[]
  battles          Battle[]
  wildCard         WildCard?
  contests         Contest[]
}

// Where a division sits on the diagram. The two left divisions meet in one
// Final Roar battle and the two right divisions in the other
enum DivisionPosition {
  TOP_LEFT
  BOTTOM_LEFT
  TOP_RIGHT
  BOTTOM_RIGHT
}

model Division {
  id        String           @id
  year      Int
  position  DivisionPosition
  name      String
  bracket   Bracket          @relation(fields: [year], references: [year], onDelete: Cascade)
  seedSlots SeedSlot[]

  @@unique([year, position])
  @@unique([year, name])
}

// Empty only when the wild card's winner fills it
model SeedSlot {
  id          String     @id
  divisionId  String
  seed        Int
  combatantId String?    @unique
  division    Division   @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  // A seed slot never loses its combatant, so deleting one fails while a slot
  // holds it. Deleting the bracket deletes both
  combatant   Combatant? @relation(fields: [combatantId], references: [id], onDelete: NoAction)
  wildCard    WildCard?

  @@unique([divisionId, seed])
}

model Combatant {
  id              String           @id
  year            Int
  name            String
  bracket         Bracket          @relation(fields: [year], references: [year], onDelete: Cascade)
  seedSlot        SeedSlot?
  wildCardEntrant WildCardEntrant?
  picks           Pick[]
  wins            Result[]

  @@unique([year, name])
}

// The battle of 2 to 4 entrants whose winner fills `seedSlot`
model WildCard {
  id         String            @id
  year       Int               @unique
  seedSlotId String            @unique
  bracket    Bracket           @relation(fields: [year], references: [year], onDelete: Cascade)
  seedSlot   SeedSlot          @relation(fields: [seedSlotId], references: [id], onDelete: Cascade)
  entrants   WildCardEntrant[]
}

model WildCardEntrant {
  wildCardId  String
  index       Int
  combatantId String    @unique
  wildCard    WildCard  @relation(fields: [wildCardId], references: [id], onDelete: Cascade)
  combatant   Combatant @relation(fields: [combatantId], references: [id], onDelete: Cascade)

  @@id([wildCardId, index])
}

enum Round {
  WILD_CARD
  ROUND_1
  ROUND_2
  SWEET_16
  ELITE_TRAIT
  FINAL_ROAR
  CHAMPIONSHIP
}

// `index` orders a round's battles top to bottom, left divisions first, as
// `app/bracket.ts` lays them out
model Battle {
  id      String  @id
  year    Int
  round   Round
  index   Int
  bracket Bracket @relation(fields: [year], references: [year], onDelete: Cascade)
  picks   Pick[]
  result  Result?

  @@unique([year, round, index])
}

// The admin's record of who won a battle, always one of its sides
model Result {
  battleId String    @id
  winnerId String
  battle   Battle    @relation(fields: [battleId], references: [id], onDelete: Cascade)
  winner   Combatant @relation(fields: [winnerId], references: [id], onDelete: Cascade)

  @@index([winnerId])
}

// A year's contests exist only while its bracket is published. Deleting the
// educator or the bracket fails while either has a contest
model Contest {
  id          String    @id
  year        Int
  educatorId  String
  name        String
  // The contest link's secret. Stored as is, since the educator copies it
  linkSecret  String    @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  // Goes up each time the contest link is replaced
  linkVersion Int       @default(1)
  // Set while the contest is in the trash
  deletedAt   DateTime?
  bracket     Bracket   @relation(fields: [year], references: [year], onDelete: Restrict)
  educator    Educator  @relation(fields: [educatorId], references: [id], onDelete: Restrict)
  players     Player[]

  @@index([educatorId, year])
  @@index([year])
}

// One person's bracket in one contest: a draft until it's submitted
model Player {
  id               String         @id
  contestId        String
  displayName      String
  // A SHA-256 hash of the personal link's secret, so a database leak reveals
  // no working link
  personalLinkHash String         @unique
  // The version of the contest link the player started with
  linkVersion      Int
  createdAt        DateTime       @default(now())
  // Both set while the player is in the trash, which a CHECK constraint ensures
  deletedAt        DateTime?
  deletedBy        PlayerDeleter?
  contest          Contest        @relation(fields: [contestId], references: [id], onDelete: Cascade)
  picks            Pick[]
  submission       Submission?

  @@index([contestId])
}

// Whoever moved a player to the trash
enum PlayerDeleter {
  EDUCATOR
  PLAYER
}

// The set of picks a pick belongs to. A player edits their draft, and submitting
// copies it to their submission
enum PickStage {
  DRAFT
  SUBMISSION
}

// A player's chosen winner of one battle, always one of its battle's sides
model Pick {
  playerId    String
  stage       PickStage
  battleId    String
  combatantId String
  player      Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  battle      Battle    @relation(fields: [battleId], references: [id], onDelete: Cascade)
  combatant   Combatant @relation(fields: [combatantId], references: [id], onDelete: Cascade)

  @@id([playerId, stage, battleId])
  @@index([battleId])
  @@index([combatantId])
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

// A player's submitted picks, which have all 64 battles, and their educator's
// approval
model Submission {
  playerId       String           @id
  status         SubmissionStatus @default(PENDING)
  createdAt      DateTime         @default(now())
  // When the submitted picks last changed. Tied scores rank the earliest first,
  // and the player sees it, so an edit they didn't make stands out
  picksChangedAt DateTime
  player         Player           @relation(fields: [playerId], references: [id], onDelete: Cascade)
}
