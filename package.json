{
  "name": "mmmm",
  "private": true,
  "description": "March Mammal Madness Manager",
  "type": "module",
  "engines": {
    "node": ">= 24.10"
  },
  "scripts": {
    "dev": "NODE_ENV=development node --conditions=development server.ts",
    "build": "react-router build",
    "start": "NODE_ENV=production node server.ts",
    "db:seed": "prisma db seed",
    "db:reset": "node prisma/push-schema.ts --force-reset && prisma generate && prisma db seed",
    "format:base": "prettier --cache --write",
    "format": "pnpm format:base . && prisma format",
    "format:check": "prettier --cache --check . && prisma format --check",
    "lint:base": "eslint --cache --cache-location node_modules/.cache/eslint/ --fix",
    "lint": "pnpm lint:base .",
    "typecheck": "react-router typegen && tsc --noEmit",
    "knip": "knip",
    "test": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "check": "npm-run-all -c -l -p check:static check:test -s test:e2e",
    "check:static": "npm-run-all -c -l -p typecheck \"lint --no-fix\" format:check knip",
    "check:test": "vitest --run",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.7",
    "@conform-to/react": "^1.21.1",
    "@conform-to/zod": "^1.21.1",
    "@fontsource/alfa-slab-one": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@react-router/express": "^8.4.0",
    "@react-router/node": "^8.4.0",
    "@simplewebauthn/browser": "13.3.0",
    "better-auth": "^1.7.7",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "isbot": "^5.2.2",
    "obscenity": "^0.4.6",
    "prisma": "^7.10.0",
    "rate-limiter-flexible": "^11.2.1",
    "react": "^19.3.0",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "uqr": "0.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "@tomer/eslint-config": "^6.0.0",
    "@tomer/prettier-config": "^5.0.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.0.3",
    "axe-core": "^4.14.0",
    "eslint": "^10.12.0",
    "knip": "^6.41.0",
    "npm-run-all2": "^9.0.3",
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vitest-browser-react": "^2.3.0"
  }
}
